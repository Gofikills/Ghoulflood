<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Привет, Яна и Арина!</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Marck+Script&family=Nunito:wght@400;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --night:#1b0a3a; --violet:#5b21b6; --orchid:#a855f7; --pink:#ec4899; --blush:#fbcfe8; --glow:#fff0fa;
  --script:'Marck Script','Segoe Script',cursive; --body:'Nunito','Segoe UI',system-ui,sans-serif;
  box-sizing:border-box; padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
*{box-sizing:border-box}
html,body{height:100%;margin:0}
body{
  font-family:var(--body); color:var(--glow); overflow:hidden; position:relative;
  background:
    radial-gradient(60% 45% at 85% 100%, rgba(236,72,153,.55), transparent 70%),
    radial-gradient(70% 50% at 10% 0%, rgba(168,85,247,.55), transparent 70%),
    linear-gradient(170deg,#2a0f5c 0%,#4c1d95 45%,#9d2a86 100%);
  user-select:none; -webkit-user-select:none; touch-action:manipulation;
}
#dust{position:fixed;inset:0;pointer-events:none;opacity:.9;
  background-image:
    radial-gradient(1.5px 1.5px at 12% 20%,#fff,transparent),radial-gradient(1px 1px at 30% 70%,#fbcfe8,transparent),
    radial-gradient(1.5px 1.5px at 55% 15%,#fff,transparent),radial-gradient(1px 1px at 72% 55%,#fff,transparent),
    radial-gradient(1.5px 1.5px at 88% 30%,#fbcfe8,transparent),radial-gradient(1px 1px at 45% 88%,#fff,transparent),
    radial-gradient(1px 1px at 8% 82%,#fff,transparent),radial-gradient(1.5px 1.5px at 93% 85%,#fff,transparent);
  animation:tw 4s ease-in-out infinite alternate}
@keyframes tw{from{opacity:.4}to{opacity:1}}
.screen{position:fixed;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px;text-align:center;z-index:5}
.hidden{display:none!important}
.card{max-width:520px;width:100%;padding:36px 28px;border-radius:32px;
  background:linear-gradient(160deg,rgba(255,255,255,.18),rgba(255,255,255,.07));
  border:1px solid rgba(255,255,255,.28);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
  box-shadow:0 20px 60px rgba(40,5,80,.45), inset 0 1px 0 rgba(255,255,255,.3)}
h1{font-family:var(--script);font-weight:400;font-size:clamp(44px,12vw,68px);line-height:1.05;margin:0 0 14px;
  background:linear-gradient(90deg,#fff,#fbcfe8 50%,#e9d5ff);-webkit-background-clip:text;background-clip:text;color:transparent;
  filter:drop-shadow(0 4px 18px rgba(236,72,153,.5))}
p{margin:0 0 22px;font-size:18px;line-height:1.6;color:#f5e1ff}
.big{width:84px;height:84px;margin:0 auto 14px;filter:drop-shadow(0 0 22px rgba(255,200,240,.9));animation:float 3s ease-in-out infinite}
@keyframes float{50%{transform:translateY(-8px) rotate(6deg)}}
button.cta{font:800 18px var(--body);color:#fff;border:0;border-radius:999px;padding:15px 38px;cursor:pointer;
  background:linear-gradient(90deg,var(--orchid),var(--pink));box-shadow:0 10px 28px rgba(236,72,153,.5);transition:transform .15s}
button.cta:hover{transform:scale(1.05)} button.cta:active{transform:scale(.97)}
button:focus-visible{outline:3px solid #fff;outline-offset:3px}
#hud{position:fixed;top:calc(env(safe-area-inset-top,0px) + 14px);left:0;right:0;z-index:6;display:flex;flex-direction:column;align-items:center;gap:6px;pointer-events:none}
#dots{display:flex;gap:5px;padding:8px 14px;border-radius:999px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.22);backdrop-filter:blur(8px)}
#dots svg{width:22px;height:22px;fill:rgba(255,255,255,.2);transition:fill .25s,transform .3s,filter .3s}
#dots svg.on{fill:url(#g);transform:scale(1.2);filter:drop-shadow(0 0 6px #ffc2ec)}
#count{font-weight:800;font-size:15px;color:var(--blush)}
.star{position:fixed;left:0;top:0;z-index:4;border:0;background:none;padding:0;cursor:pointer;will-change:transform;-webkit-tap-highlight-color:transparent}
.star svg{width:100%;height:100%;fill:url(#g);filter:drop-shadow(0 0 10px rgba(255,170,230,.95))}
.spark{position:fixed;width:8px;height:8px;border-radius:50%;z-index:7;pointer-events:none;background:#ffd1f0;box-shadow:0 0 10px #ff9bdc;animation:burst .6s ease-out forwards}
@keyframes burst{to{transform:translate(var(--dx),var(--dy)) scale(0);opacity:0}}
.conf{position:fixed;top:-20px;z-index:8;pointer-events:none;width:10px;height:16px;border-radius:3px;animation:fall linear forwards}
@keyframes fall{to{transform:translate(var(--sx),110vh) rotate(720deg)}}
#win .card{max-height:92vh;overflow:auto}
#win p{font-size:17px;text-align:left;margin-bottom:14px}
#win .sign{text-align:center;font-family:var(--script);font-size:30px;margin:6px 0 20px;color:#fff}
@media (prefers-reduced-motion:reduce){#dust,.big{animation:none}.conf{display:none}}
</style>
</head>
<body>
<div id="dust"></div>
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
  <linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff3b8"/><stop offset=".5" stop-color="#ffb3e6"/><stop offset="1" stop-color="#c084fc"/></linearGradient>
  <symbol id="s" viewBox="0 0 24 24"><path d="M12 2l2.9 6.6 7.1.6-5.4 4.7 1.7 7-6.3-3.8-6.3 3.8 1.7-7L2 9.2l7.1-.6z" stroke-linejoin="round" stroke="currentColor" stroke-width="1.2"/></symbol>
</defs></svg>

<section id="start" class="screen"><div class="card">
  <svg class="big" style="fill:url(#g);color:#ffd9f3"><use href="#s"/></svg>
  <h1>Привет, Яна и&nbsp;Арина!</h1>
  <p>Для вас у меня есть небольшой сюрприз. Поймайте 10&nbsp;падающих звёзд, и&nbsp;вы его получите.</p>
  <button class="cta" id="play">Играть</button>
</div></section>

<div id="hud" class="hidden"><div id="dots"></div><div id="count">0 из 10</div></div>

<section id="win" class="screen hidden"><div class="card">
  <svg class="big" style="fill:url(#g);color:#ffd9f3"><use href="#s"/></svg>
  <h1>Вы поймали все звёзды!</h1>
  <p>Яна, Арина, пусть всё, о чём вы мечтаете, сбывается так же легко, как эти звёзды сами падали к вам в руки.</p>
  <p>Желаю вам вдохновения каждый день, тёплых людей рядом, смелых планов и сто причин для улыбки. Верьте в себя: вы справитесь с чем угодно.</p>
  <p>А если вдруг станет грустно, просто вспомните, что звёзды всегда на вашей стороне.</p>
  <div class="sign">С любовью и теплом</div>
  <button class="cta" id="again">Сыграть ещё</button>
</div></section>

<script>
(function(){
  var $=function(id){return document.getElementById(id)};
  var GOAL=10, caught=0, stars=[], running=false, last=0, spawnT=0, raf=0;
  var dots=$('dots');
  for(var i=0;i<GOAL;i++){dots.insertAdjacentHTML('beforeend','<svg><use href="#s"/></svg>')}
  var dotEls=dots.children;

  function show(id){['start','win'].forEach(function(s){$(s).classList.toggle('hidden',s!==id)});$('hud').classList.toggle('hidden',id!=='game')}
  function spawn(){
    var size=52+Math.random()*30, W=innerWidth;
    var el=document.createElement('button');
    el.className='star'; el.setAttribute('aria-label','Звезда');
    el.style.width=el.style.height=size+'px';
    el.innerHTML='<svg style="color:#ffd9f3"><use href="#s"/></svg>';
    var o={el:el,size:size,x0:size/2+Math.random()*(W-size*1.5),y:-size,v:110+Math.random()*120,ph:Math.random()*6,amp:8+Math.random()*18,rot:0,vr:(Math.random()-.5)*120};
    el.addEventListener('pointerdown',function(e){e.preventDefault();grab(o)});
    document.body.appendChild(el); stars.push(o);
  }
  function burst(x,y){
    for(var i=0;i<10;i++){
      var s=document.createElement('div'),a=Math.random()*6.283,d=30+Math.random()*50;
      s.className='spark'; s.style.left=x+'px'; s.style.top=y+'px';
      s.style.setProperty('--dx',Math.cos(a)*d+'px'); s.style.setProperty('--dy',Math.sin(a)*d+'px');
      document.body.appendChild(s); setTimeout(function(n){n.remove()},650,s);
    }
  }
  function grab(o){
    if(!running)return;
    var i=stars.indexOf(o); if(i<0)return;
    stars.splice(i,1); o.el.remove();
    burst(o.x+o.size/2,o.y+o.size/2);
    dotEls[caught].classList.add('on'); caught++;
    $('count').textContent=caught+' из '+GOAL;
    if(caught>=GOAL)win();
  }
  function frame(t){
    if(!running)return;
    var dt=Math.min((t-last)/1000,.05); last=t; spawnT+=dt;
    if(spawnT>.7&&stars.length<6){spawnT=0;spawn()}
    for(var i=stars.length-1;i>=0;i--){
      var o=stars[i]; o.y+=o.v*dt; o.rot+=o.vr*dt;
      o.x=o.x0+Math.sin(o.y/60+o.ph)*o.amp-o.size/2;
      o.el.style.transform='translate('+o.x+'px,'+o.y+'px) rotate('+o.rot+'deg)';
      if(o.y>innerHeight+10){o.el.remove();stars.splice(i,1)}
    }
    raf=requestAnimationFrame(frame);
  }
  function clear(){stars.forEach(function(o){o.el.remove()});stars=[]}
  function start(){
    clear(); caught=0; spawnT=1; running=true;
    for(var i=0;i<GOAL;i++)dotEls[i].classList.remove('on');
    $('count').textContent='0 из '+GOAL; show('game');
    last=performance.now(); cancelAnimationFrame(raf); raf=requestAnimationFrame(frame);
  }
  function win(){
    running=false; cancelAnimationFrame(raf); clear(); show('win');
    var cols=['#fff3b8','#ffb3e6','#c084fc','#ec4899','#f9a8d4','#e9d5ff'];
    for(var i=0;i<70;i++){
      var c=document.createElement('div'); c.className='conf';
      c.style.left=Math.random()*100+'vw'; c.style.background=cols[i%cols.length];
      c.style.setProperty('--sx',(Math.random()-.5)*160+'px');
      c.style.animationDuration=(2.5+Math.random()*2.5)+'s'; c.style.animationDelay=Math.random()*1.2+'s';
      document.body.appendChild(c); setTimeout(function(n){n.remove()},7000,c);
    }
  }
  $('play').addEventListener('click',start);
  $('again').addEventListener('click',start);
})();
</script>
</body>
</html>
